generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vault         Vault?
  credentials   Credential[]
  shares        Share[]
  resetRequests PassphraseResetRequest[]
}

model Vault {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Argon2id parameters + salt used to derive a key-encryption key (KEK)
  // from the user's vault passphrase. Stored so the same params are used
  // every time the vault is unlocked.
  kdfSalt        String
  kdfMemoryCost  Int
  kdfTimeCost    Int
  kdfParallelism Int

  // The actual vault data-encryption key (DEK) is randomly generated once,
  // then "wrapped" (AES-256-GCM encrypted) using the KEK derived above.
  // The server only ever sees the wrapped (encrypted) key. Changing the
  // vault passphrase only re-wraps this value with a new KEK -- it never
  // requires touching or re-encrypting individual credentials.
  wrappedVaultKey   String
  wrappedVaultKeyIv String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Credential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Site name, URL, username, password, and notes are bundled into one JSON
  // object and AES-256-GCM encrypted client-side (using the vault DEK) before
  // it ever reaches the server. The server stores and returns opaque bytes.
  encryptedData String
  iv            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares Share[]

  @@index([userId])
}

model Share {
  id           String     @id @default(cuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Never store the raw share token or raw OTP -- only verifiers.
  tokenHash   String @unique
  otpVerifier String

  // otpVerifier is HMAC-SHA256(server pepper, tokenHash:otp) -- see
  // lib/share/server.ts. The payload key is HKDF(linkKey, payloadSalt), where
  // linkKey lives only in the share URL's #fragment and never reaches the
  // server. OTP *verification* and payload *decryption* are fully separate:
  // the server can gate access but can never decrypt (lib/share/crypto.ts).
  encryptedPayload String
  payloadIv        String
  payloadSalt      String

  // When true the whole row is deleted the moment the share is opened
  // (instead of being kept as a "Used" record in the owner's history).
  destroyOnOpen Boolean @default(false)

  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  failedAttempts Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Fixed-window rate-limit counters. Lives in Postgres because serverless
// instances share no memory. `key` is "<bucket>:<sha256(identifier)>" --
// client IPs are hashed, never stored raw.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

enum ResetStatus {
  PENDING
  APPROVED
  DENIED
  COMPLETED
  CANCELLED
}

// A user who forgot their vault passphrase asks an admin for permission to
// reset it. The vault is zero-knowledge, so approval cannot recover anything:
// it only authorises wiping the vault key + credentials so the user can start
// a fresh vault (see app/api/vault/reset).
model PassphraseResetRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status ResetStatus @default(PENDING)
  // Optional note from the user, shown to the admin.
  reason String?

  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  // User.id of the admin who approved/denied.
  decidedBy   String?
  // An approval is only usable until this time.
  expiresAt   DateTime?
  completedAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Append-only activity trail. No foreign key on purpose: history must outlive
// the account it describes. Never store secrets, ciphertext or IPs here --
// `detail` is a short human label.
model AuditLog {
  id       String  @id @default(cuid())
  // Account the event is about.
  userId   String
  // Who performed it, when different from userId (admin actions).
  actorId  String?
  action   String
  // Credential / share / request id the action touched.
  targetId String?
  detail   String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([action, createdAt])
}
